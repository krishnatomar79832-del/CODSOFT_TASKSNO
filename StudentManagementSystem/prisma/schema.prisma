generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  student      Student?
  teacher      Teacher?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id          String       @id @default(cuid())
  admissionNo String       @unique
  fullName    String
  email       String       @unique
  phone       String?
  className   String
  section     String?
  dateOfBirth DateTime?
  address     String?
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id])
  attendance  Attendance[]
  results     Result[]
  fees        Fee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Teacher {
  id         String   @id @default(cuid())
  employeeNo String   @unique
  fullName   String
  email      String   @unique
  subject    String
  phone      String?
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String
  subject   String?
  markedBy  String?
  createdAt DateTime @default(now())
  @@unique([studentId, date, subject])
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  subject     String
  className   String
  examDate    DateTime
  maxMarks    Int      @default(100)
  results     Result[]
  createdAt   DateTime @default(now())
}

model Result {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  marks     Float
  grade     String?
  remarks   String?
  @@unique([studentId, examId])
}

model Fee {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  paidAmount  Float    @default(0)
  dueDate     DateTime
  status      String   @default("PENDING")
  description String?
  createdAt   DateTime @default(now())
}
